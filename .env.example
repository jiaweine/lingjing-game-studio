# ================================================================
# 灵境游戏工作台 · Environment template
# ================================================================
# Development defaults are intentionally zero-config. For production,
# copy the SaaS section into your secret manager / deployment platform.

# ---------- Core runtime ----------
WORLDFORGE_ENV=development
WORLDFORGE_DATA=./outputs/runtime
WORLDFORGE_AUTH_MODE=dev
WORLDFORGE_AUTO_CREATE_SCHEMA=1
WORLDFORGE_MAX_UPLOAD_MB=120
WORLDFORGE_RATE_LIMIT_PER_MINUTE=120
WORLDFORGE_REQUEST_LOG=1

# SQLite by default. Production example:
# DATABASE_URL=postgresql+psycopg://lingjing:CHANGE_ME@postgres:5432/lingjing
DATABASE_URL=

# ---------- Production identity / security ----------
# Required when WORLDFORGE_ENV=production.
WORLDFORGE_JWT_SECRET=
WORLDFORGE_JWT_ISSUER=lingjing-game-studio
WORLDFORGE_JWT_AUDIENCE=lingjing-web
WORLDFORGE_ACCESS_TOKEN_MINUTES=720
WORLDFORGE_SECURE_COOKIES=0
WORLDFORGE_CORS_ORIGINS=http://localhost:8765
WORLDFORGE_TRUSTED_HOSTS=localhost,127.0.0.1

# ---------- Job execution ----------
# inprocess: local development / single API container
# external: API only enqueues durable DB jobs; run `python -m worldforge.worker`
WORLDFORGE_QUEUE_MODE=inprocess
WORLDFORGE_WORKER_IDLE_SECONDS=0.8
WORLDFORGE_JOB_LEASE_SECONDS=120
WORLDFORGE_JOB_HEARTBEAT_SECONDS=30

# ---------- Object storage ----------
# local or s3. S3 works with AWS S3 and S3-compatible services such as MinIO.
WORLDFORGE_STORAGE_BACKEND=local
S3_BUCKET=
S3_REGION=
S3_ENDPOINT_URL=
S3_ACCESS_KEY=
S3_SECRET_KEY=

# ---------- Model services (all optional) ----------
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_BASE_URL=https://api.openai.com/v1

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=

GEMINI_API_KEY=
GEMINI_MODEL=

DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-pro
DEEPSEEK_BASE_URL=https://api.deepseek.com

DASHSCOPE_API_KEY=
QWEN_MODEL=qwen3-vl-plus
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

ARK_API_KEY=
DOUBAO_MODEL=
DOUBAO_BASE_URL=https://ark.cn-beijing.volces.com/api/v3

CUSTOM_BASE_URL=
CUSTOM_API_KEY=
CUSTOM_MODEL=
CUSTOM_MULTIMODAL=1
