# Copy to .env.production (do not commit it) and use:
# docker compose --env-file .env.production -f docker-compose.prod.yml up --build
#
# Production is expected to sit behind HTTPS. Do not copy the example hostnames
# unchanged: replace them with the public hostname/origin served by your TLS proxy.

POSTGRES_PASSWORD=CHANGE_ME_LONG_RANDOM_PASSWORD
MINIO_ROOT_USER=lingjing
MINIO_ROOT_PASSWORD=CHANGE_ME_LONG_RANDOM_PASSWORD
WORLDFORGE_JWT_SECRET=CHANGE_ME_TO_AT_LEAST_64_RANDOM_CHARACTERS

# Secure cookies are the production default. Set to 0 only for explicit local HTTP
# testing, not for an Internet-facing deployment.
WORLDFORGE_SECURE_COOKIES=1

# Same-origin deployments can leave CORS empty. Add only trusted cross-origin frontends.
WORLDFORGE_CORS_ORIGINS=
# Required by docker-compose.prod.yml: set the public API/UI host(s), comma-separated.
WORLDFORGE_TRUSTED_HOSTS=game-studio.example.com

OPENAI_API_KEY=
OPENAI_MODEL=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
GEMINI_API_KEY=
GEMINI_MODEL=
