# Copy to .env.production (do not commit it) and use:
# docker compose --env-file .env.production -f docker-compose.prod.yml up --build

POSTGRES_PASSWORD=CHANGE_ME_LONG_RANDOM_PASSWORD
MINIO_ROOT_USER=lingjing
MINIO_ROOT_PASSWORD=CHANGE_ME_LONG_RANDOM_PASSWORD
WORLDFORGE_JWT_SECRET=CHANGE_ME_TO_AT_LEAST_64_RANDOM_CHARACTERS

# Set to 1 behind HTTPS. Keep 0 only for localhost HTTP testing.
WORLDFORGE_SECURE_COOKIES=0
WORLDFORGE_CORS_ORIGINS=http://localhost:8765
WORLDFORGE_TRUSTED_HOSTS=localhost,127.0.0.1
WORLDFORGE_JOB_LEASE_SECONDS=120
WORLDFORGE_JOB_HEARTBEAT_SECONDS=30

OPENAI_API_KEY=
OPENAI_MODEL=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
GEMINI_API_KEY=
